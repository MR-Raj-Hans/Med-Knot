{
  "expo": {
    "name": "MedKnot",
    "slug": "medknot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medknot",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.medknot.patient",
      "supportsTablet": true
    },
    "android": {
      "package": "com.medknot.patient",
      "adaptiveIcon": {
        "backgroundColor": "#17364B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F4"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "MedKnot can use a photo you choose for your patient profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3aac34be-f139-4a91-bdb2-6eb165b9bbbe"
      }
    },
    "owner": "rajhans"
  }
}
